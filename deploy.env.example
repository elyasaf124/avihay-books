# העתק ל־`deploy.env` וב־Docker Compose טען: `docker compose --env-file deploy.env up --build`
# או הגדר את המשתנים בסביבת הטרמינל לפני `docker compose up`.

# מפתח שחייב לתאום ל־`EXPO_PUBLIC_API_KEY` באפליקציה אם בשימוש (כותרת `x-api-key`)
APP_API_KEY=

# `true` — להריץ `npm run db:seed` בכל הפעלה מחודשת (בדרך כלל `false` בפרודקשן)
RUN_SEED_ON_START=false
