# העתק ל־`backend/.env.development` (או ל־`backend/.env`)
# נטען כש־NODE_ENV אינו production. ראה גם `../.env.example`.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/book-store
DATABASE_SSL=false
PORT=4000
CORS_ORIGIN=*
LOG_LEVEL=debug
APP_API_KEY=
APP_MIN_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
APP_UPDATE_URL=https://example.com/avihay-books.apk
APP_MAINTENANCE_MODE=false
APP_MAINTENANCE_MESSAGE=
APP_FEATURE_FLAGS={}

# אופציונלי: REMOVE_FROM_DISPLAY_AFTER (Postgres interval). בלי שורה — ברירת מחדל בקוד: 1 month.
# לבדיקה קצרה: REMOVE_FROM_DISPLAY_AFTER=1 minute
