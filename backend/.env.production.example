# העתק ל־`backend/.env.production` או הגדר את אותם מפתחות ב־Render/Docker
# נטען כש־NODE_ENV=production. ראה גם `../.env.example`.

# Neon may append ?sslmode=require — the app strips it; TLS is set by host / DATABASE_SSL.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxxx.neon.tech/neondb
DATABASE_SSL=
PORT=4000
CORS_ORIGIN=*
LOG_LEVEL=info
APP_API_KEY=
APP_MIN_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
APP_UPDATE_URL=https://example.com/avihay-books.apk
APP_MAINTENANCE_MODE=false
APP_MAINTENANCE_MESSAGE=
APP_FEATURE_FLAGS={}
