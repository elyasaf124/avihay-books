# =============================================================================
# Backend בלבד — טעינה לפי NODE_ENV: `.env` → `.env.<NODE_ENV>` → `.env.local` → `.env.<NODE_ENV>.local`
# ראה גם `../.env.example` (שני המצבים + משתני mobile לתיעוד).
# NODE_ENV נקבע ע"י: `cross-env` ב־npm run dev / start, או ע"י שרת הענן.
# מפתח API: מהשורש `npm run generate-api-key` — אותו ערך ל־`EXPO_PUBLIC_API_KEY` ב־mobile.
# =============================================================================

# ---------------------- פיתוח (NODE_ENV=development) ----------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/book-store
DATABASE_SSL=false
PORT=4000
CORS_ORIGIN=*
LOG_LEVEL=debug
APP_API_KEY=
APP_MIN_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
APP_UPDATE_URL=https://example.com/avihay-books.apk
APP_MAINTENANCE_MODE=false
APP_MAINTENANCE_MESSAGE=
APP_FEATURE_FLAGS={}

# Postgres interval — ספר is_new מקבל התראת «הסר מחזית» רק אם added_at ישן יותר ממשך זה.
# ברירת מחדל בקוד: 1 month — כמה דקות לא יספיקו אלא אם מגדירים למטה.
# לפיתוח / בדיקה: הסירו את ההערה מהשורה הבאה, שמרו והפעילו מחדש את השרת:
# REMOVE_FROM_DISPLAY_AFTER=1 minute
# (בסיום הבדיקה — מחקו או שוב `#` כדי לחזור לחודש)

# ---------------------- בוט וואטסאפ (WhatsApp Cloud API) ----------------------
# הבוט מעבד הודעות רק כש-WHATSAPP_ENABLED=true והטוקנים מוגדרים. ראה docs/WHATSAPP_BOT.md.
WHATSAPP_ENABLED=false
# מזהי Meta (מ-App Dashboard > WhatsApp > API Setup):
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# טוקן קבוע (System User access token) עם הרשאות whatsapp_business_messaging:
WHATSAPP_ACCESS_TOKEN=
# App Secret (Settings > Basic) — לאימות חתימת X-Hub-Signature-256:
WHATSAPP_APP_SECRET=
# מחרוזת שרירותית שתגדיר גם ב-Webhook config של Meta (Verify token):
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# חזרה אוטומטית מהבוט אחרי מענה אנושי (דקות):
WHATSAPP_HANDOVER_TIMEOUT_MIN=180
# חלון שעות מענה אנושי (ענף 8) בפורמט HH-HH:
WHATSAPP_HUMAN_HOURS=14-18

# Templates מאושרות ב-Meta לשליחת עדכוני הזמנה יזומים ללקוח (order_updates_only):
WHATSAPP_TEMPLATE_LANG=he
WHATSAPP_TEMPLATE_ORDER_READY=order_ready_pickup

# ---------------------- תוכן הבוט (ניתן לעקיפה; ברירות מחדל בקוד) -------------
# BOT_STORE_ADDRESS=בניין הישיבה הגבוהה - קומה ראשונה, רחוב הארז, עלי
# BOT_WAZE_URL=https://waze.com/ul?q=...
# BOT_BANK_DETAILS=נועם הספר\nבנק הפועלים\nסניף 286\nחשבון 78929
# BOT_PAYMENT_CREDIT_URL=https://ultra.kesherhk.info/external/paymentPage/314594
# BOT_PAYMENT_BIT_URL=https://meshulam.co.il/quick_payment?b=7583d8adc7013c94a822b5f0d7a2d711
# BOT_PAYMENT_PAYBOX_URL=
# BOT_CATALOG_PDF_URL=https://.../catalog.pdf
# BOT_UPDATES_GROUP_URL=https://chat.whatsapp.com/...
# BOT_DELIVERY_HOME_FEE=39
# BOT_DELIVERY_POINT_FEE=25

# ---------------------- פרודקשן (NODE_ENV=production) — דוגמה בהערות --------
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxxx.neon.tech/neondb
# Neon may append ?sslmode=require — the app strips it; TLS is set by host / DATABASE_SSL.
# DATABASE_SSL=
# PORT=4000
# CORS_ORIGIN=*
# LOG_LEVEL=info
# APP_API_KEY=
# APP_MIN_VERSION=0.1.0
# APP_LATEST_VERSION=0.1.0
# APP_UPDATE_URL=https://example.com/avihay-books.apk
# APP_MAINTENANCE_MODE=false
# APP_MAINTENANCE_MESSAGE=
# APP_FEATURE_FLAGS={}
