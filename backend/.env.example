# =============================================================================
# Backend בלבד — טעינה לפי NODE_ENV: `.env` → `.env.<NODE_ENV>` → `.env.local` → `.env.<NODE_ENV>.local`
# ראה גם `../.env.example` (שני המצבים + משתני mobile לתיעוד).
# NODE_ENV נקבע ע"י: `cross-env` ב־npm run dev / start, או ע"י שרת הענן.
# =============================================================================

# ---------------------- פיתוח (NODE_ENV=development) ----------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/book-store
DATABASE_SSL=false
PORT=4000
CORS_ORIGIN=*
LOG_LEVEL=debug
APP_API_KEY=
APP_MIN_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
APP_UPDATE_URL=https://example.com/avihay-books.apk
APP_MAINTENANCE_MODE=false
APP_MAINTENANCE_MESSAGE=
APP_FEATURE_FLAGS={}

# ---------------------- פרודקשן (NODE_ENV=production) — דוגמה בהערות --------
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxxx.neon.tech/neondb?sslmode=require
# DATABASE_SSL=
# PORT=4000
# CORS_ORIGIN=*
# LOG_LEVEL=info
# APP_API_KEY=
# APP_MIN_VERSION=0.1.0
# APP_LATEST_VERSION=0.1.0
# APP_UPDATE_URL=https://example.com/avihay-books.apk
# APP_MAINTENANCE_MODE=false
# APP_MAINTENANCE_MESSAGE=
# APP_FEATURE_FLAGS={}
