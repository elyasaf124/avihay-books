# העתק ל־`mobile/.env.production` (בניית APK/Store מול שרת ציבורי). או הגדר ב־`expo.dev`. ראה `../.env.example`.

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://your-service.onrender.com/api/v1
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Push (Android): הורד google-services.json מ-Firebase → mobile/google-services.json
# ראה docs/PUSH_NOTIFICATIONS.md
