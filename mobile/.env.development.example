# העתק ל־`mobile/.env.development` (פיתוח / APK פנימי מול API מקומי). ראה `../.env.example`.
# טלפון פיזי באותה Wi‑Fi: IP של המחשב (למשל `192.168.1.10`).
# אימולator Android: אותו IP בקובץ — האפליקציה תתרגם אוטומטית ל־`10.0.2.2` (alias למחשב המארח).

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
