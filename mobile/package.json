{
  "name": "@avihay-books/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/link-hoisted-native-deps.cjs && npm run build --prefix ../shared",
    "start": "node scripts/metro-dev.cjs",
    "start:dev": "node scripts/metro-dev.cjs",
    "android": "expo run:android",
    "android:dev": "node scripts/android-dev.cjs",
    "android:dev:fresh": "node scripts/android-dev.cjs --fresh",
    "android:dev:build": "node scripts/android-dev.cjs --build",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild:android": "node scripts/check-google-services.cjs && node scripts/run-with-monorepo-root.cjs npx expo prebuild --platform android",
    "apk:release": "node scripts/apk-release.cjs",
    "apk:release:gradle": "node scripts/gradle-assemble-release.cjs",
    "eas:credentials": "npx eas-cli@latest credentials",
    "eas:build:android:development": "dotenv -e .env.development -- npx eas-cli@latest build --profile development --platform android",
    "eas:build:android:production": "dotenv -e .env.production -- npx eas-cli@latest build --profile production --platform android",
    "eas:build:ios:development": "dotenv -e .env.development -- npx eas-cli@latest build --profile development --platform ios",
    "eas:build:ios:production": "dotenv -e .env.production -- npx eas-cli@latest build --profile production --platform ios"
  },
  "dependencies": {
    "@avihay-books/shared": "0.1.0",
    "@expo-google-fonts/heebo": "^0.4.2",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.51.21",
    "axios": "^1.7.4",
    "expo": "^54.0.0",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "query-string": "^7.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.3",
    "use-latest-callback": "^0.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "dotenv-cli": "^8.0.0",
    "typescript": "~5.9.2"
  }
}
