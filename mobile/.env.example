# העתק ל־`mobile/.env` (לא בקומיט). Expo טוען קובץ זה מהתיקייה `mobile/`.
# פריסת שרת + `HTTPS`: `docs/DEPLOYMENT.md` · דוגמה לפרודקשן: `.env.production.example`

# --- מסלול א': Expo Go + טלפון ברשת הבית ---
# הגדר את ה־`IPv4` של המחשב (למשל מאת `ipconfig` ב־Windows), טלפון ומחשב על אותו Wi‑Fi.
# ה־`backend` חייב זמין (למשל `npm run backend:dev` על פורט 4000).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1

# --- מסלול ב': בניית `APK` / `EAS` ---
# כתובת `API` ציבורית (`HTTPS` מומלץ). אפשר גם להגדיר ב־`eas.json` או במשתני סביבה ב־expo.dev.
# EXPO_PUBLIC_API_BASE_URL=https://your-server.example.com/api/v1

# אם ה־`API` דורש מפתח חיבור
EXPO_PUBLIC_API_KEY=

# אופציונלי: לאחר `eas init`, הזן את ה־UUID של הפרויק트 כדי להפעיל עדכוני `OTA` ב־`app.config.js`
EXPO_PUBLIC_EAS_PROJECT_ID=
