# =============================================================================
# Mobile (Expo) — העתק ל־`mobile/.env`
# ראה גם `../.env.example` לרשימה מלאה (backend + mobile לשני מצבים).
# =============================================================================

# ---------------------- פיתוח (Expo Go / מטרו מקומי) ----------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---------------------- פרודקשן / APK (מול שרת ציבורי) — דוגמה בהערות -----
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_API_BASE_URL=https://your-service.onrender.com/api/v1
# EXPO_PUBLIC_API_KEY=
# EXPO_PUBLIC_EAS_PROJECT_ID=
