{
  "expo": {
    "name": "נועם הספר",
    "slug": "avihay-books",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "avihaybooks",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#3d2817"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avihay.books"
    },
    "android": {
      "package": "com.avihay.books",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3d2817",
          "image": "./assets/splash.png",
          "resizeMode": "cover"
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-notifications",
      "./withForceRTL"
    ],
    "experiments": {
      "typedRoutes": false,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1",
      "apiKey": null,
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
