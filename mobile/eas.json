{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://YOUR_SERVER_DOMAIN/api/v1",
        "EXPO_PUBLIC_API_KEY": "CHANGE_ME",
        "EXPO_PUBLIC_EAS_PROJECT_ID": ""
      }
    },
    "production": {
      "channel": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://YOUR_SERVER_DOMAIN/api/v1",
        "EXPO_PUBLIC_API_KEY": "CHANGE_ME",
        "EXPO_PUBLIC_EAS_PROJECT_ID": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
