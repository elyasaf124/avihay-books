# =============================================================================
# avihay-books-V2 — דוגמת סביבה: פיתוח (פעיל) + פרודקשן (הערות)
# אין להעלות קובץ `.env` אמיתי לגיט.
#
# העתקה:
#   · בלוק "Backend פיתוח" → `backend/.env` או `backend/.env.development`
#   · בלוק "Mobile פיתוח" → `mobile/.env.development` (או `mobile/.env`)
#   · פרודקשן mobile: `mobile/.env.production` · `eas.json` / `eas build`
# טעינת backend: `backend/src/config/loadEnv.ts`
# מפתח API: `npm run generate-api-key` — אותו ערך ל־`APP_API_KEY` (backend) ול־`EXPO_PUBLIC_API_KEY` (mobile)
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — פיתוח (NODE_ENV=development)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/book-store
DATABASE_SSL=false
PORT=4000
CORS_ORIGIN=*
LOG_LEVEL=debug
APP_API_KEY=
APP_MIN_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
APP_UPDATE_URL=https://example.com/avihay-books.apk
APP_MAINTENANCE_MODE=false
APP_MAINTENANCE_MESSAGE=
APP_FEATURE_FLAGS={}

# בוט וואטסאפ (WhatsApp Cloud API) — ראה backend/.env.example ו-docs/WHATSAPP_BOT.md
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=he
WHATSAPP_TEMPLATE_ORDER_READY=order_ready_pickup
WHATSAPP_TEMPLATE_PAYMENT_LINK=order_payment_link

# -----------------------------------------------------------------------------
# Mobile — פיתוח (Expo Go / מטרו מקומי)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# =============================================================================
# Backend — פרודקשן (NODE_ENV=production) — דוגמאות; העתק ל־.env.production או לענן
# =============================================================================
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxxx.neon.tech/neondb
# Neon may append ?sslmode=require — the app strips it; TLS is set by host / DATABASE_SSL.
# DATABASE_SSL=
# PORT=4000
# CORS_ORIGIN=*
# LOG_LEVEL=info
# APP_API_KEY=מחרוזת_חזקה_בדיוק_כמו_במובייל
# APP_MIN_VERSION=0.1.0
# APP_LATEST_VERSION=0.1.0
# APP_UPDATE_URL=https://example.com/avihay-books.apk
# APP_MAINTENANCE_MODE=false
# APP_MAINTENANCE_MESSAGE=
# APP_FEATURE_FLAGS={}

# =============================================================================
# Mobile — פרודקשן / APK — דוגמאות; לעדכן ב־EAS או ב־mobile/.env לפני בנייה
# =============================================================================
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_API_BASE_URL=https://your-service.onrender.com/api/v1
# EXPO_PUBLIC_API_KEY=
# EXPO_PUBLIC_EAS_PROJECT_ID=
